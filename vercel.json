{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/*.js": {
            "maxDuration": 30
        }
    },
    "headers": [
        {
            "source": "/",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
            ]
        },
        {
            "source": "/i18n.js",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
            ]
        }
    ]
}
